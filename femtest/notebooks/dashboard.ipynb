    "\n",
    "print(\"C-C точечная:\", w_cc_point(a, h, E, nu, F))                   # ≈ 4.46e-4 м\n",
    "print(\"C-C пятно ≈ :\", w_cc_patch_approx(a, b, h, E, nu, F, ap, bp)) # ~ совпадает\n"
   ]
